{
  "fred_series": {
    "name": "FRED Series",
    "description": "Fetch and display FRED economic data series using custom header authentication",
    "category": "Economic Data",
    "type": "table",
    "endpoint": "fred_series",
    "gridData": {
      "w": 20,
      "h": 12
    },
    "source": "Federal Reserve Economic Data (FRED)",
    "data": {
      "table": {
        "enableCharts": true,
        "showAll": false,
        "chartView": {
          "enabled": true,
          "chartType": "line"
        }
      }
    },
    "params": [
      {
        "paramName": "series_id",
        "value": "SP500",
        "label": "Series ID",
        "type": "text",
        "description": "FRED series identifier(s). Multiple comma separated items allowed.",
        "optional": false,
        "show": true,
        "multiSelect": true,
        "multiple": true,
        "style": {
          "popupWidth": 450
        }
      },
      {
        "paramName": "start_date",
        "value": "2020-01-01",
        "label": "Start Date",
        "type": "date",
        "description": "Start date for data retrieval"
      }
    ]
  }
}