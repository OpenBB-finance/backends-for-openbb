        "show": true
      },
      {
        "paramName": "api_key",
        "value": "",
        "label": "API Key",
        "type": "text",
        "description": "Etherscan API key (optional, uses env if not provided)",
        "show": false
      }
    ]
  },
  "transactions": {
    "name": "Transaction History",
    "description": "Shows normal ETH transactions for the address",
    "category": "Portfolio",
    "subcategory": "Transactions",
    "type": "table",
    "endpoint": "transactions",
    "gridData": {
      "w": 30,
      "h": 8
    },
    "source": [
      "Etherscan API"
    ],
    "data": {
      "table": {
        "enableCharts": true,
        "showAll": false,
        "chartView": {
          "enabled": false,
          "chartType": "line"
        },
        "columnsDefs": [
          {
            "field": "Date",
            "headerName": "Date",
            "cellDataType": "dateString",
            "chartDataType": "time",
            "width": 150
          },
          {
            "field": "Hash",
            "headerName": "Tx Hash",
            "cellDataType": "text",
            "chartDataType": "excluded",
            "width": 120
          },
          {
            "field": "From",
            "headerName": "From",
            "cellDataType": "text",
            "chartDataType": "excluded",
            "width": 120
          },
          {
            "field": "To",
            "headerName": "To",
            "cellDataType": "text",
            "chartDataType": "excluded",
            "width": 120
          },
          {
            "field": "Value (ETH)",
            "headerName": "Value (ETH)",
            "cellDataType": "number",
            "chartDataType": "series",
            "formatterFn": "none",
            "width": 120
          },
          {
            "field": "Gas Fee (ETH)",
            "headerName": "Gas Fee (ETH)",
            "cellDataType": "number",
            "chartDataType": "series",
            "formatterFn": "none",
            "width": 120
          },
          {
            "field": "Status",
            "headerName": "Status",
            "cellDataType": "text",
            "chartDataType": "excluded",
            "renderFn": "greenRed",
            "renderFnParams": {
              "greenValue": "Success",
              "redValue": "Failed"
            },
            "width": 100
          },
          {
            "field": "Block",
            "headerName": "Block",
            "cellDataType": "number",
            "chartDataType": "excluded",
            "width": 100
          }
        ]
      }
    },
    "params": [
      {
        "paramName": "address",
        "value": "",
        "label": "Ethereum Address",
        "type": "text",
        "description": "Ethereum address to fetch transactions",
        "optional": false,
        "show": true
      },
      {
        "paramName": "limit",
        "value": 100,
        "label": "Limit",
        "type": "number",
        "description": "Number of transactions to fetch",
        "optional": true,
        "show": true
      },
      {
        "paramName": "api_key",
        "value": "",
        "label": "API Key",
        "type": "text",
        "description": "Etherscan API key",
        "show": false
      }
    ]
  },
