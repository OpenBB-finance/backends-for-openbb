{
  "name": "DTCC Trading Strategy",
  "description": "Advanced trading insights and investment strategy dashboard featuring repo squeeze detection, sentiment analysis, liquidity fragmentation monitoring, arbitrage opportunities, and flow momentum tracking.",
  "img": "https://images.unsplash.com/photo-1618044619888-009e412ff12a?w=400&h=300&fit=crop",
  "allowCustomization": true,
  "tabs": {
    "notes": {
      "id": "notes",
      "name": "Notes",
      "layout": [
        {
          "i": "trading_strategy/notes",
          "x": 0,
          "y": 2,
          "w": 40,
          "h": 30,
          "groups": []
        }
      ]
    },
    "market_opportunities": {
      "id": "market_opportunities",
      "name": "Market Opportunities",
      "layout": [
        {
          "i": "trading_strategy/metrics",
          "x": 0,
          "y": 2,
          "w": 40,
          "h": 5,
          "groups": []
        },
        {
          "i": "trading_strategy/repo_squeeze",
          "x": 0,
          "y": 7,
          "w": 40,
          "h": 12,
          "groups": [
            "Security Filter Sync"
          ]
        },
        {
          "i": "trading_strategy/arbitrage_monitor",
          "x": 0,
          "y": 19,
          "w": 40,
          "h": 11,
          "state": {
            "chartView": {
              "enabled": false,
              "chartType": "scatter"
            },
            "columnState": {
              "default": {
                "columnPinning": {
                  "leftColIds": [
                    "opportunity"
                  ],
                  "rightColIds": []
                }
              }
            }
          },
          "groups": []
        }
      ]
    },
    "sentiment_flows": {
      "id": "sentiment_flows",
      "name": "Sentiment & Flows",
      "layout": [
        {
          "i": "trading_strategy/sentiment_gauge",
          "x": 0,
          "y": 2,
          "w": 20,
          "h": 14,
          "state": {
            "chartView": {
              "enabled": true,
              "chartType": "bar"
            }
          },
          "groups": []
        },
        {
          "i": "trading_strategy/liquidity_fragmentation",
          "x": 20,
          "y": 2,
          "w": 20,
          "h": 14,
          "groups": []
        },
        {
          "i": "trading_strategy/flow_momentum",
          "x": 0,
          "y": 16,
          "w": 40,
          "h": 12,
          "groups": []
        }
      ]
    }
  },
  "groups": [
    {
      "name": "Security Filter Sync",
      "type": "param",
      "paramName": "security_filter",
      "defaultValue": "All",
      "widgetIds": [
        "trading_strategy/repo_squeeze"
      ]
    }
  ],
  "prompts": [
    "Are there any repo squeeze events happening right now?",
    "Show me the best cross-asset arbitrage opportunities",
    "What does short interest sentiment tell us about market direction?",
    "Analyze flow momentum for the top 10 most traded securities",
    "Which securities show signs of liquidity fragmentation?"
  ]
}